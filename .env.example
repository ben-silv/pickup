# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# Both values come from Supabase → Project Settings → API. They're public by design: the anon key can only
# do what the database's Row Level Security allows for the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your deployed URL, used in sign-in emails (otherwise taken from the request).
# NEXT_PUBLIC_SITE_URL=https://pickup-tufts.vercel.app

# Optional: Umami website ID for analytics.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
